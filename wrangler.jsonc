{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: fetch() can't reach private addresses, which lets the
  // OAuth library fetch Client ID Metadata Documents (CIMD) safely for MCP clients.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // The URL MCP clients connect to; every access token is bound to it.
    // `npm run dev` overrides it with http://localhost:8787/mcp (.dev.vars can't:
    // with `secrets` declared, wrangler dev loads only those keys from it).
    "MCP_RESOURCE": "https://cloud-bridge.ivan-seredkin.workers.dev/mcp",
    // How long a tools/call waits for the arm's answer.
    "ARM_CALL_TIMEOUT_MS": "120000"
  },
  // wrangler dev simulates it locally; deploys use this namespace.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "17fe14e95ad64871bd2417c565d2dcff" }],
  "durable_objects": {
    "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  "dev": { "port": 8787 },
  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "COOKIE_ENCRYPTION_KEY"]
  }
}
