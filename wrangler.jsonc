{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: a fetch() of the hub's own address goes through
  // Cloudflare's front door like any Internet request (not straight to an origin).
  // It is not a private-address filter; Workers can't reach internal networks anyway.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // The URL MCP clients connect to; every access token is bound to it.
    // `npm run dev` overrides it with http://localhost:8787/mcp (.dev.vars can't:
    // with `secrets` declared, wrangler dev loads only those keys from it).
    "MCP_RESOURCE": "https://cloud-bridge.ivan-seredkin.workers.dev/mcp",
    // How long a tools/call waits for the arm's answer.
    "ARM_CALL_TIMEOUT_MS": "120000"
  },
  // wrangler dev simulates it locally; deploys use this namespace. Since S1 it holds
  // only file blobs (and OAuth keys from before the move, until they're read once):
  // the free plan gives it 1,000 writes a day for the whole account.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "17fe14e95ad64871bd2417c565d2dcff" }],
  "durable_objects": {
    "bindings": [
      { "name": "USER_HUB", "class_name": "UserHub" },
      // OAuth state + pairing + web sign-in state (src/store.ts), behind the KV interface.
      { "name": "OAUTH_STORE", "class_name": "OAuthStore" }
    ]
  },
  // Per-network limits on the routes anyone can call without signing in
  // (src/limits.ts). Counts are per Cloudflare location and approximate; the
  // period must be 10 or 60 seconds. namespace_id is unique in the account.
  "ratelimits": [
    // /register, GET /authorize, /login, /callback, /pair/start: each 10 a minute per network.
    { "name": "SIGNIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // /pair/poll (every 3s while a code waits), /arm, /arm/revoke: each 60 a minute per network.
    { "name": "ARM_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v2", "new_sqlite_classes": ["OAuthStore"] }
  ],
  // Errors only: per-request invocation logs would keep every request (sign-in
  // codes in URLs, bearer tokens) for 3 days, readable by the hub's operator.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "dev": { "port": 8787 },
  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "COOKIE_ENCRYPTION_KEY"]
  }
}
